{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CopyDeck",
  "version": "0.1.0",
  "identifier": "app.copydeck.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "CopyDeck",
        "width": 420,
        "height": 760,
        "minWidth": 360,
        "minHeight": 650,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
